# URL do backend real (back-plataforma-ibbf). Nunca usar prefixo NEXT_PUBLIC_ aqui —
# essa variável só deve ser lida em Route Handlers / infra/api server-side.
BACKEND_API_URL=http://localhost:3010

# Habilita a flag "secure" nos cookies de autenticação (httpOnly). Deixe vazio/"false"
# para testar `next build && next start` localmente via HTTP; use "true" em produção (HTTPS).
COOKIE_SECURE=false
